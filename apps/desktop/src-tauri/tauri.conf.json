{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transfert",
  "version": "0.3.5",
  "identifier": "com.viincnt.transfert",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Transfert",
        "width": 1100,
        "height": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "wix": {
        "template": "wix/main.wxs"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFNkQ4MjkzN0E4RkIzMjkKUldRcHM0OTZrNEp0THVybzE4cUxYbmt0YitTNmVNNVpPU3I4V1BxV0plSFRQTEhDNFFXUExEcHIK",
      "endpoints": [
        "https://github.com/viincnt/Transfert/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
