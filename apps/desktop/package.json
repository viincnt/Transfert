{
  "name": "desktop",
  "private": true,
  "version": "0.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:media": "cargo test --manifest-path src-tauri/Cargo.toml --lib libvlc_audio_round_trips_and_rejects_corruption -- --ignored --test-threads=1 && cargo test --manifest-path src-tauri/Cargo.toml --lib libvlc_video_outputs_are_readable -- --ignored --test-threads=1",
    "test:media:regression": "cargo test --manifest-path src-tauri/Cargo.toml --lib libvlc_pcm_sample_regression -- --ignored",
    "prepare:vlc": "node ../../scripts/prepare-vlc.mjs",
    "bundle": "pnpm prepare:vlc && tauri build --config src-tauri/tauri.vlc.conf.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.1.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.4"
  }
}
